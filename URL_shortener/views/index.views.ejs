<!DOCTYPE html>
<html lang="en">

<head>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
    </style>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>home page</title>

</head>

<body>
    <h1>URL shortener</h1>
    <% if (locals.id) { %>
        <p>URL generated: http://localhost:8000/url/<%= id %>
        </p>
        <% } %>

            <div>
                <form method="POST" action="/url">
                    <label>Enter your original URL</label>
                    <input type="text" name="url" placeholder="https://example.com">
                    <button type="submit">Generate ShortURL</button>
                </form>
            </div>
            <div>
                <% if (locals.urls) { %>
                    <table>
                        <thead>
                            <th>s.num</th>
                            <th>ShortID</th>
                            <th>Redirect</th>
                            <th>clicks</th>
                        </thead>
                        <tbody>
                            <% urls.forEach((element,index)=> { %>
                                <tr>
                                <td><%= index+1 %></td>
                                <td><%= element.shortId %></td>
                                <td><%= element.redirectURL %></td>
                                <td><%= element.visitHistory.length %></td>
                                </tr>
                                <% }) %>
                        </tbody>
                    </table>
                    <% } %>
            </div>
</body>

</html>