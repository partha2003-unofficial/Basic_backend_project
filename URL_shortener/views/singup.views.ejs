<!DOCTYPE html>
<html lang="en">

<head>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #2f7a78, #6fb3ae);
            color: white;
            margin: 0;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        h1 {
            font-size: 2.4rem;
            font-weight: 800;
            letter-spacing: -0.5px;
            margin-bottom: 24px;
            text-transform: capitalize;
        }

        form {
            background: rgba(255, 255, 255, 0.08);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.15);
            border-radius: 16px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.25);
            padding: 40px;
            display: flex;
            flex-direction: column;
            gap: 6px;
            width: 100%;
            max-width: 380px;
        }

        label {
            font-weight: 600;
            font-size: 0.9rem;
            margin-top: 12px;
        }

        input[type="text"] {
            padding: 12px 14px;
            border-radius: 8px;
            border: none;
            outline: none;
            font-size: 0.95rem;
            background: #fff;
            color: #222;
            transition: box-shadow 0.2s ease;
        }

        input[type="text"]:focus {
            box-shadow: 0 0 0 3px rgba(255, 179, 71, 0.5);
        }

        button {
            margin-top: 24px;
            padding: 12px 20px;
            border: none;
            border-radius: 8px;
            background: #ffb347;
            color: #2b2b2b;
            font-weight: 700;
            font-size: 0.95rem;
            cursor: pointer;
            text-transform: capitalize;
            transition: transform 0.15s ease, background 0.2s ease;
        }

        button:hover {
            background: #ffc266;
            transform: translateY(-1px);
        }

        button:active {
            transform: translateY(0);
        }
    </style>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>singup</title>
</head>

<body>
    <h1>singup</h1>
    <form action="/user" method="post">
        <label>Full Name: </label>
        <input type="text" required placeholder="full name" name="name">
        <label>Email ID : </label>
        <input type="text" required placeholder="email" name="email">
        <label>Password : </label>
        <input type="text" required placeholder="password" name="password">
        <button type="submit">submit</button>
    </form>
</body>

</html>