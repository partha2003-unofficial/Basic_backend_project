<!DOCTYPE html>
<html lang="en">

<head>
  <!-- including the file that present in the partials component -->
  <%- include('./partials/head.partials.ejs') %>
    <title>Blogging Application || signin</title>
    <style>
      body {
        min-height: 100vh;
        margin: 0;
        background: linear-gradient(135deg, #0f0c29, #302b63, #24243e);
        font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        color: #f1f1f1;
      }

      .signup-wrapper {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: calc(100vh - 80px);
        padding: 2rem 1rem;
      }

      .signup-card {
        background: rgba(255, 255, 255, 0.06);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 16px;
        padding: 2.5rem 2.5rem 2rem;
        width: 100%;
        max-width: 440px;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
      }

      .signup-card h2 {
        text-align: center;
        margin-bottom: 1.75rem;
        font-weight: 700;
        letter-spacing: 0.5px;
        background: linear-gradient(90deg, #a18cd1, #fbc2eb);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
      }

      .signup-card .form-label {
        color: #d8d8d8;
        font-weight: 500;
        font-size: 0.9rem;
      }

      .signup-card .form-control {
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.15);
        color: #fff;
        border-radius: 8px;
        padding: 0.65rem 0.9rem;
      }

      .signup-card .form-control::placeholder {
        color: rgba(255, 255, 255, 0.4);
      }

      .signup-card .form-control:focus {
        background: rgba(255, 255, 255, 0.12);
        border-color: #a18cd1;
        box-shadow: 0 0 0 0.2rem rgba(161, 140, 209, 0.25);
        color: #fff;
      }

      .signup-card .form-text {
        color: rgba(255, 255, 255, 0.5);
        font-size: 0.8rem;
      }

      .signup-card .btn-primary {
        width: 100%;
        margin-top: 0.5rem;
        padding: 0.7rem;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        letter-spacing: 0.5px;
        background: linear-gradient(90deg, #a18cd1, #fbc2eb);
        color: #1a1a1a;
        transition: transform 0.15s ease, box-shadow 0.15s ease;
      }

      .signup-card .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 18px rgba(161, 140, 209, 0.4);
        color: #000;
      }

      .signup-card .mb-3 {
        margin-bottom: 1.25rem !important;
      }
    </style>
</head>

<body>
  <!-- navbar -->
  <%- include('./partials/navbar.partials.ejs') %>

    <div class="signup-wrapper">
      <div class="signup-card">
        <h2>Signin Account</h2>
        <form action="/user/signin" method="post">
          <div class="mb-3">
            <label for="email" class="form-label">Email address</label>
            <input type="email" class="form-control" name="email" id="email" aria-describedby="emailHelp"
              placeholder="you@example.com">
            <div id="emailHelp" class="form-text">We'll never share your email with anyone else.</div>
          </div>
          <div class="mb-3">
            <label for="exampleInputPassword1" class="form-label">Password</label>
            <input type="password" class="form-control" id="exampleInputPassword1" name="password" placeholder="••••••••">
          </div>
          <button type="submit" class="btn btn-primary">Sign In</button>
        </form>
      </div>
    </div>

    <!-- script tags -->
    <%- include('./partials/scripts.partials.ejs') %>
</body>

</html>