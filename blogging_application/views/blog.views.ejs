<!DOCTYPE html>
<html lang="en">

<head>
    <!-- including the file that present in the partials component -->
    <%- include('./partials/head.partials.ejs') %>
        <title>Blogging Application</title>

        <style>
            body {
                min-height: 100vh;
                margin: 0;
                background: linear-gradient(135deg, #0f0c29, #302b63, #24243e);
                font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
                color: #f1f1f1;
            }

            .blog-container {
                padding-top: 2rem;
                padding-bottom: 3rem;
            }

            .blog-card {
                background: rgba(255, 255, 255, 0.06);
                backdrop-filter: blur(12px);
                border: 1px solid rgba(255, 255, 255, 0.12);
                border-radius: 16px;
                overflow: hidden;
                box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
                padding: 1.5rem;
            }

            .blog-title {
                font-weight: 700;
                letter-spacing: 0.3px;
                background: linear-gradient(90deg, #a18cd1, #fbc2eb);
                -webkit-background-clip: text;
                background-clip: text;
                color: transparent;
                margin-bottom: 1rem;
            }

            .blog-cover-img {
                width: 100%;
                max-width: 700px;
                border-radius: 12px;
                border: 1px solid rgba(255, 255, 255, 0.12);
                margin-bottom: 1rem;
                display: block;
            }

            .blog-body {
                background: rgba(0, 0, 0, 0.2);
                border-radius: 10px;
                padding: 1rem;
                white-space: pre-wrap;
                font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
                color: #e6e6e6;
                line-height: 1.6;
            }

            .profile-card {
                background: rgba(255, 255, 255, 0.06);
                backdrop-filter: blur(12px);
                border: 1px solid rgba(255, 255, 255, 0.12);
                border-radius: 16px;
                padding: 1rem 1.25rem;
                display: flex;
                align-items: center;
                gap: 0.75rem;
                box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
            }

            .profile-img {
                border-radius: 50%;
                border: 2px solid rgba(255, 255, 255, 0.2);
            }

            .profile-name {
                font-weight: 600;
                letter-spacing: 0.3px;
            }

            .comment-section {
                background: rgba(255, 255, 255, 0.06);
                backdrop-filter: blur(12px);
                border: 1px solid rgba(255, 255, 255, 0.12);
                border-radius: 16px;
                padding: 1.5rem;
                box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
            }

            .comment-section h1 {
                font-size: 1.4rem;
                font-weight: 700;
                background: linear-gradient(90deg, #a18cd1, #fbc2eb);
                -webkit-background-clip: text;
                background-clip: text;
                color: transparent;
                margin-bottom: 1rem;
            }

            .comment-form .form-label {
                color: #d8d8d8;
                font-weight: 500;
            }

            .comment-form input[type="text"] {
                width: 100%;
                background: rgba(255, 255, 255, 0.08);
                border: 1px solid rgba(255, 255, 255, 0.15);
                border-radius: 8px;
                padding: 0.6rem 0.8rem;
                color: #f1f1f1;
                outline: none;
                transition: border-color 0.15s ease, box-shadow 0.15s ease;
            }

            .comment-form input[type="text"]::placeholder {
                color: rgba(241, 241, 241, 0.5);
            }

            .comment-form input[type="text"]:focus {
                border-color: #a18cd1;
                box-shadow: 0 0 0 3px rgba(161, 140, 209, 0.25);
            }

            .comment-form .btn-primary {
                border: none;
                border-radius: 8px;
                padding: 0.55rem 1.2rem;
                font-weight: 600;
                letter-spacing: 0.5px;
                background: linear-gradient(90deg, #a18cd1, #fbc2eb);
                color: #1a1a1a;
                transition: transform 0.15s ease, box-shadow 0.15s ease;
            }

            .comment-form .btn-primary:hover {
                transform: translateY(-2px);
                box-shadow: 0 6px 18px rgba(161, 140, 209, 0.4);
                color: #000;
            }

            .comments-count {
                color: #cbb9e6;
                font-weight: 600;
                margin-bottom: 1rem;
            }

            .comment-item {
                display: flex;
                gap: 0.75rem;
                align-items: flex-start;
                background: rgba(255, 255, 255, 0.04);
                border: 1px solid rgba(255, 255, 255, 0.08);
                border-radius: 12px;
                padding: 0.9rem 1rem;
                margin-bottom: 0.9rem;
            }

            .comment-item .profile-img {
                flex-shrink: 0;
            }

            .comment-item .comment-author {
                font-weight: 600;
                letter-spacing: 0.2px;
                margin-bottom: 0.3rem;
            }

            .comment-item .comment-content {
                white-space: pre-wrap;
                color: #dcdcdc;
                margin: 0;
                font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            }
        </style>
</head>

<body>
    <!-- navbar -->
    <%- include('./partials/navbar.partials.ejs') %>
        <!-- body -->

        <!-- blog -->
        <% if (locals.blog && locals.user) { %>
            <div class="container mt-3 blog-container">

                <div class="blog-card mb-3">
                    <h1 class="blog-title">
                        <%= blog.title %>
                    </h1>
                    <img class="blog-cover-img" src="<%= blog.coverImage %>" alt="card image">
                    <pre class="blog-body"><%= blog.body %></pre> <!-- pre-> the tag is maintaining the spaceing  -->
                </div>

                <!-- profile -->
                <div class="profile-card mb-3">
                    <img class="profile-img" src="<%= locals.user.profileImage %>" alt="profileImage" width="50px" />
                    <span class="profile-name"><%= user.fullName %></span>
                </div>

                <!-- comment -->
                <div class="comment-section">
                    <% if ( locals.user) { %>
                        <h1>Enter your comments</h1>
                        <form class="comment-form" action="/blogs/comment/<%=blog._id %>" method="post">
                            <div class="mb-3">
                                <label for="comment" class="form-label">comment</label>
                                <input type="text" name="comment" id="comment" placeholder="enter your comments ">
                            </div>
                            <button type="submit" class="btn btn-primary">submit</button>
                        </form>
                    <% } %>

                    <!-- display comments -->
                    <% if (locals.comment) { %>
                        <p class="comments-count mt-4">comments(<%= comment.length %>)</p>
                        <% comment.forEach(comment=> { %>
                            <div class="comment-item">
                                <img class="profile-img" src="<%= comment.createdBy.profileImage %>" alt="profileImage" width="50px">
                                <div>
                                    <div class="comment-author"><%= comment.createdBy.fullName %></div>
                                    <pre class="comment-content"><%= comment.content %></pre>
                                </div>
                            </div>
                        <% }) %>
                    <% } %>
                </div>

            </div>
        <% } %>

                <!-- script tags -->
                <%- include('./partials/scripts.partials.ejs') %>
</body>

</html>