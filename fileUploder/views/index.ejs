<!DOCTYPE html>
<html lang="en">

<head>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            font-family: Arial, sans-serif;
            background: linear-gradient(135deg, #667eea, #764ba2);
        }

        .upload-card {
            width: min(90%, 430px);
            padding: 40px;
            background: rgba(255, 255, 255, 0.96);
            border-radius: 22px;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.2);
            text-align: center;
        }

        .upload-card h1 {
            margin-bottom: 10px;
            color: #222;
            font-size: 30px;
        }

        .upload-card p {
            margin-bottom: 28px;
            color: #777;
            font-size: 14px;
        }

        .file-box {
            display: block;
            padding: 25px 15px;
            border: 2px dashed #8b7cf6;
            border-radius: 15px;
            background: #f8f7ff;
            cursor: pointer;
            transition: 0.3s;
        }

        .file-box:hover {
            background: #efedff;
            border-color: #6c5ce7;
        }

        .file-box input {
            width: 100%;
            cursor: pointer;
        }

        button {
            width: 100%;
            margin-top: 22px;
            padding: 14px;
            border: none;
            border-radius: 12px;
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: white;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            transition: 0.3s;
        }

        button:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(102, 126, 234, 0.35);
        }

        button:active {
            transform: translateY(0);
        }
    </style>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>File Upload</title>
</head>

<body>
    <div class="upload-card">
        <h1>Upload File</h1>
        <p>Choose a file and upload it to the server</p>

        <form action="/upload" method="post" enctype="multipart/form-data">
            <label class="file-box">
                <input type="file" name="new_file">
            </label>

            <button type="submit">Upload File</button>
        </form>
    </div>
</body>

</html>